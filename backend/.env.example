# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string, e.g. from Neon (neon.tech) — free, no card,
# and unlike Supabase's free tier it doesn't pause your project after inactivity.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

OPENAI_API_KEY=sk-your-key-here
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API in production, e.g.:
# ALLOWED_ORIGINS=https://your-frontend-domain.com
ALLOWED_ORIGINS=
